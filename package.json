{
  "name": "pumpkin-hollow-quality",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "package:companion": "node scripts/package-companion.mjs",
    "check": "tsc --project jsconfig.json",
    "lint": "eslint packages/companion/dist/pumpkin-hollow-companion.js scripts/*.mjs tests/*.test.mjs eslint.config.js",
    "verify": "npm run check && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2"
  }
}
